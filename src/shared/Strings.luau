local function localeIsPolish(): boolean
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	return player ~= nil and player.LocaleId:sub(1, 2) == "pl"
end

local active: { [string]: string }? = nil

function Strings.get(key: string, ...: any): string
	if active == nil then
		active = if POLISH_TRANSLATION and localeIsPolish() then PL else EN
	end
	local text = (active :: { [string]: string })[key] or EN[key] or key
	for index = 1, select("#", ...) do
		text = text:gsub(`{"{"}{index}{"}"}`, tostring((select(index, ...))))
	end
	return text
end

-- Server-side prompt text has no locale; it stays in the language of the place's source.
function Strings.server(key: string): string
	return EN[key] or key
end

return Strings
